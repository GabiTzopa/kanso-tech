{%- style -%}
  .kanso-hero-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="kanso-hero kanso-hero-{{ section.id }}" aria-label="{{ section.settings.heading | escape }}">
  <div class="kanso-hero-container">
    {%- if section.settings.badge_text != blank -%}
      <div class="kanso-hero__badge">
        <span class="kanso-hero__badge-dot"></span>
        <span>{{ section.settings.badge_text }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="kanso-hero__headline">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="kanso-hero__subheadline">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="kanso-hero__actions">
      {%- if section.settings.button_label_1 != blank -%}
        <a href="{{ section.settings.button_link_1 }}" class="button button--kanso-primary">
          {{ section.settings.button_label_1 }}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 }}" class="button button--kanso-secondary">
          {{ section.settings.button_label_2 }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div style="display: flex; justify-content: center; gap: 32px; margin-top: 48px; flex-wrap: wrap;">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }} style="display: flex; align-items: center; gap: 8px; color: var(--kanso-text-secondary); font-size: 0.85rem; letter-spacing: 0.05em; text-transform: uppercase;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--kanso-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{{ block.settings.stat_text }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Kanso Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Eyebrow / Badge Text",
      "default": "ARCHITECTURAL DESK GEAR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Order, Distilled. Precision Workspace Tools."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheadline",
      "default": "KansoTech designs modular desk architecture and minimalist peripherals—crafted to remove visual noise and amplify your daily output."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary Button Label",
      "default": "Explore the Ecosystem"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary Button Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary Button Label",
      "default": "View Specifications"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary Button Link",
      "default": "#specs"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 160,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 160,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "feature_pill",
      "name": "Feature Pill",
      "settings": [
        {
          "type": "text",
          "id": "stat_text",
          "label": "Feature text",
          "default": "Aerospace Grade Aluminum"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kanso Hero",
      "blocks": [
        {
          "type": "feature_pill",
          "settings": {
            "stat_text": "Aerospace Grade Aluminum"
          }
        },
        {
          "type": "feature_pill",
          "settings": {
            "stat_text": "45kg Dual Display Support"
          }
        },
        {
          "type": "feature_pill",
          "settings": {
            "stat_text": "3-Year Structural Warranty"
          }
        }
      ]
    }
  ]
}
{% endschema %}
